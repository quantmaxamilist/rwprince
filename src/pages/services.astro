---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import DirectoryGroup from '../components/DirectoryGroup.astro';
import { directoryGroups } from '../data/site';
---

<Base
  title="Services | R W Prince — Somerset"
  description="Full list of R W Prince services: aggregates and materials, asphalt and surfacing, recycling and waste disposal, and plant hire and contracting."
>
  <PageHeader
    crumb="Services"
    eyebrow="What we do"
    title="Every service we offer, in one list"
    lede="From raw materials to a fully operated machine on site, here is the complete range R W Prince provides across our Podimore yard. For more detail on aggregates, asphalt or plant hire, visit their dedicated pages."
  />

  <section class="directory">
    <div class="wrap">
      {directoryGroups.map((group) => <DirectoryGroup group={group} />)}
    </div>
  </section>

  <CtaBand
    heading="Can't see exactly what you need?"
    text="Give the yard a call — if it's related to aggregates, asphalt, waste or plant, we can probably help."
  />
</Base>
