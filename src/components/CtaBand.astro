---
import { site } from '../data/site';

interface Props {
  heading: string;
  text: string;
}

const { heading, text } = Astro.props;
---

<section class="cta-band">
  <div class="wrap cta-band-inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band-actions">
      <a href={site.phoneHref} class="btn btn-primary btn-lg">{site.phone}</a>
      <a href="/contact" class="btn btn-ghost-dark btn-lg">Send an enquiry</a>
    </div>
  </div>
</section>
