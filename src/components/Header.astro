---
import { navItems, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/index\.html$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path === `${href}/`);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <img src="/images/logo-trimmed.png" alt="R W Prince" class="brand-logo" />
    </a>
    <nav class="nav" id="nav">
      {navItems.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <a href={site.phoneHref} class="btn btn-primary header-cta">Call Now</a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
